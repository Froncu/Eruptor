{
   "version": 3,
   "configurePresets": [
      {
         "name": "base",
         "hidden": true,
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "toolchainFile": "${sourceDir}/toolchain.cmake"
      },
      {
         "name": "debug",
         "inherits": "base",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
         }
      },
      {
         "name": "release",
         "inherits": "base",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release"
         }
      }
   ]
}